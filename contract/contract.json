{
  "skill_id": "bdmvkit",
  "id": "bdmvkit",
  "version": "0.8.0",
  "contract_version": "1.0",
  "provides": [
    {
      "id": "bluray.encode_clip",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "bdmvkit/encode"
    },
    {
      "id": "bluray.author",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "bdmvkit/build"
    },
    {
      "id": "bluray.plan_disc",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "bdmvkit/plan"
    }
  ],
  "dependencies": [],
  "external_tools": [
    {
      "id": "ffmpeg",
      "required": true,
      "detail": "with libx264; encodes clips and menus"
    }
  ],
  "not_provided": [
    "disc images (udfkit)",
    "burning a disc",
    "DVD-Video (vtskit, oncemore)",
    "copy protection of any kind",
    "network access of any kind"
  ],
  "tools": [
    {
      "tool_id": "bdmvkit/encode",
      "kind": "cli",
      "writes_media": true,
      "mutates_input": false,
      "description": "Encode a video into a Blu-ray clip (.m2ts) with ffmpeg + x264",
      "argv": [
        "encode",
        "<source>",
        "<clip.m2ts>",
        "[--fps 24000/1001|25|30000/1001]",
        "[--chapters 0,60,120]",
        "[--fast]"
      ]
    },
    {
      "tool_id": "bdmvkit/build",
      "kind": "cli",
      "writes_media": true,
      "mutates_input": false,
      "description": "Write a BDMV folder (playlists, clip information, HDMV navigation, menus, PGS subtitles) from encoded clips and a disc description",
      "argv": [
        "build",
        "<disc.json>",
        "<out_dir>",
        "[--fast]"
      ]
    },
    {
      "tool_id": "bdmvkit/plan",
      "kind": "cli",
      "writes_media": false,
      "mutates_input": false,
      "description": "Plan a proceedings disc from a chapter list: each session a title (or a chapter), the video bit rate of each on a BD-25 or BD-50, whether it is above its quality floor (exit 1 when not), the discs the floors need, and menu entries from the session titles",
      "argv": [
        "plan",
        "<chapters>",
        "[--disc bd25|bd50]",
        "[--mode titles|chapters]",
        "[--floor 6M]",
        "[--audio 192k]",
        "[--duration H:MM:SS]",
        "[--reserve 0.03]"
      ]
    }
  ],
  "python_api": "bdmvkit.Disc",
  "execution": {
    "canonical_invocation": [
      "bdmvkit",
      "contract",
      "--json"
    ],
    "network": false,
    "shell": false
  }
}
